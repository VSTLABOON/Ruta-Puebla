FROM python:3.12-slim

WORKDIR /app

ARG SERVICE_DIR=services/route

# Copiar dependencias y datos requeridos
COPY pipelines/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY data/processed ./data/processed
COPY config ./config
COPY ${SERVICE_DIR} ./service

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["sh", "-c", "uvicorn service.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
