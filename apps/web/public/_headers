# Service Worker: siempre fresco, nunca en caché de edge ni navegador
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifiesto y datos dinámicos de POIs y grafos
/data/*
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# Assets estáticos con hash de Vite: caché inmutable de 1 año
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Reglas generales de seguridad para todas las páginas
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
