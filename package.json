{
  "name": "ruta-abierta-puebla",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de generacion de rutas peatonales accesibles y turismo sostenible en Puebla",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "test": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run test",
    "lint": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run lint",
    "dev": "pnpm --filter web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
